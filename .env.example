# Docker / GHCR Deployment Configuration
CORECAPITAL_IMAGE="ghcr.io/gunnhil25/corecapital:dev"

# PostgreSQL 16 Credentials
POSTGRES_USER="corecapital_user"
POSTGRES_PASSWORD="change_me_secure_password"
POSTGRES_DB="corecapital"

# Database connection string for PostgreSQL 16 (used for standalone / non-compose runs)
DATABASE_URL="postgres://corecapital_user:change_me_secure_password@localhost:5432/corecapital"
DB_MAX_CONNECTIONS=10

# Open Banking (CDR / Basiq / Frollo) Webhook HMAC Secret
OPEN_BANKING_WEBHOOK_SECRET="change_me_webhook_secret"

# Session Token Signing Secret (use a long random string in production)
AUTH_SECRET="change_me_auth_secret_key"

# Next.js Server Configuration
PORT=3000
HOSTNAME="0.0.0.0"
NODE_ENV="production"

# Cloudflare Tunnel Hostname
NEXT_PUBLIC_APP_URL="https://budget.yourdomain.internal"
